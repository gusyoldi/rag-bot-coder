DOMAIN_ID=product-owner
OLLAMA_BASE_URL=http://localhost:11434
CHROMA_PERSIST_DIR=./data/chroma
# Trello REST tools (https://trello.com/power-ups/admin → API key + token)
TRELLO_API_KEY=
TRELLO_TOKEN=

# LangSmith (cloud) — set API key to enable tracing (forces LANGSMITH_TRACING=true)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=po-copilot
# legacy alias still accepted by configure_observability:
LANGCHAIN_API_KEY=

# Phoenix (local) — pnpm phoenix, then set PHOENIX_ENABLED=true
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT=po-copilot
